# The password for the whole factory. Without it a deployment is closed and a laptop is open.
FACTORY_PASSWORD=

# Image model and review model. Without it, pairs that are already generated still
# run, and every brief waits for a person in review.
OPENAI_API_KEY=
# IMAGE_MODEL=gpt-image-1.5
# JUDGE_MODEL=gpt-4o

# Seals the accounts' sign-ins. 32 characters or more. Never change it once accounts are connected.
FACTORY_SECRET=

# The platforms' developer apps. A platform with no keys is not offered in Accounts.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# The cloud: Postgres (Neon) and the Vercel Blob store. With both set, the database
# and the media live there, on a deployment and on this Mac alike. Without them a
# laptop keeps everything in /data.
# DATABASE_URL=
# BLOB_READ_WRITE_TOKEN=
# FACTORY_TZ=Europe/London
