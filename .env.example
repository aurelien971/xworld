# Image model and review model. Without it, pairs that are already generated still
# run, and every brief waits for a person in review.
OPENAI_API_KEY=
# IMAGE_MODEL=gpt-image-1.5
# JUDGE_MODEL=gpt-4o

# The publisher. Both must be set, and the account's registry file must have
# status "active" and a target, before anything is sent.
MITSUSHIRO_URL=https://mitsushiro.studio
MITSUSHIRO_INGEST_SECRET=

# Optional. Postgres (Neon) instead of the embedded database in /data.
# DATABASE_URL=
# FACTORY_TZ=Europe/London
